# Copy to .env.pi on the Pi. This file takes priority over old shell exports.
TERRA_PI_TOKEN=YOUR_SHARED_TOKEN_FROM_LAPTOP
TERRA_CAMERA=pi
TERRA_WIDTH=1280
TERRA_HEIGHT=720
TERRA_DETECTOR=ssd
TERRA_CONFIDENCE=0.5
TERRA_ROI_FILE=roi.live.json
# Used only when TERRA_DETECTOR=yolo:
TERRA_MODEL=models/yolov8n.onnx
