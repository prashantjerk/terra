# Copy to .env, replace placeholders, and keep local. No quotes around values.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/terra_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
# Use the Pi hostname if it resolves on this laptop; otherwise use its current IP.
TERRA_PI_URL=http://karkip-pi.local:8090/detect
TERRA_PI_TOKEN=YOUR_SHARED_TOKEN_MATCHING_PI
